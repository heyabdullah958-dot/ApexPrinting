# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration
# Option 1: Gmail SMTP
# Note: Google Gmail SMTP rewrites the From header to the authenticated Gmail address unless
# quotes@apexprinthub.com is configured as a verified "Send mail as" alias in Gmail Settings.
EMAIL_USER=apex.printing.noreply@gmail.com
EMAIL_PASS=your-gmail-app-password
OWNER_EMAIL=quotes@apexprinthub.com
EMAIL_FROM=quotes@apexprinthub.com
EMAIL_FROM_ADDRESS="Apex Print Hub" <quotes@apexprinthub.com>
EMAIL_FROM_NAME=Apex Print Hub
EMAIL_REPLY_TO=quotes@apexprinthub.com

# Option 2: Custom Domain SMTP Relay (e.g. mail.apexprinthub.com, Titan, SendGrid)
# Bypasses Gmail From-rewriting and authenticates directly with domain SPF records
# SMTP_HOST=mail.apexprinthub.com
# SMTP_PORT=465
# SMTP_SECURE=true
# (Or for port 587 STARTTLS: SMTP_PORT=587 and SMTP_SECURE=false)
# SMTP_USER=quotes@apexprinthub.com
# SMTP_PASS=your-custom-smtp-password

# Currency Exchange API
EXCHANGE_API_KEY=your-exchangerate-api-key
EXCHANGE_BASE_CURRENCY=AED

# Business Info
BUSINESS_NAME=Apex Print Hub
BUSINESS_PHONE=+971-XX-XXX-XXXX
BUSINESS_ADDRESS=Dubai, UAE
